# 복사해서 .env 로 저장 (git에 안 올라감)
# --- Claude (원고 자동 생성) ---
ANTHROPIC_API_KEY=

# --- Instagram API (Instagram API with Facebook Login, 프로페셔널 계정) ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Threads API ---
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- 스레드 영상은 공개 URL이 필요 (video_url). 둘 중 하나 ---
# 1) out/ 폴더를 이미 공개 호스팅 중이면 그 주소
MEDIA_BASE_URL=
# 2) S3 호환 스토리지(Cloudflare R2 등) 자동 업로드
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- 브라우저 자동화(방법 B) / 스크래퍼 ---
CHROME_PROFILE_DIR=./chrome-profile-insaengtem
CHROME_CHANNEL=chrome
# 설치.bat 이 찾은 ffmpeg 폴더
FFMPEG_DIR=
# 메타 비즈니스 스위트 릴스 작성기 주소의 asset_id / business_id
META_ASSET_ID=
META_BUSINESS_ID=

# --- 폰트(선택) ---
# INSAENGTEM_FONT_BLACK=C:/Windows/Fonts/malgunbd.ttf

# --- 링크샵 공개 주소 (shop deploy 가 자동 입력, 직접 호스팅 시 수동) ---
SHOP_PUBLIC_URL=
