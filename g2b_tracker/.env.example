# 공공데이터포털(data.go.kr) 일반 인증키 - Decoding 값을 붙여 넣으세요 (Encoding 값이어도 자동 처리)
DATA_GO_KR_KEY=

# 텔레그램 알림 (블로그 프로그램 .env 의 값을 그대로 복사해도 됩니다. 비우면 알림 없이 파일만 저장)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 매일 몇 일치를 다시 훑을지 (기본 3일. 하루 이틀 빠져도 놓치지 않게)
LOOKBACK_DAYS=3

# 텔레그램으로 보낼 최소 점수 (60 = 즉시 연락, 40 = 추적까지)
ALERT_MIN_SCORE=40
