# .env 양식 — 이 파일을 복사해서 이름을 .env 로 바꾸고 값을 채운다.
# .env 파일은 절대 다른 사람에게 보내거나 인터넷에 올리지 않는다.

# 네이버 블로그 아이디 (blog.naver.com/여기부분)
# 비밀번호는 넣지 않는다. 로그인은 1_네이버로그인.bat 으로 한 번만 직접 한다.
BLOG_ID=
NAVER_CATEGORY=포장이사

# Anthropic API (console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5

# 회사 정보
COMPANY_PHONE=010-0000-0000

# 사진 폴더 (Google Drive 데스크톱 동기화 폴더 경로). 비워 두면 blog-auto/photos 폴더를 쓴다.
PHOTO_DIR=

# 실행 설정
AUTO_PUBLISH=false
DAILY_LIMIT=2
PUBLISH_WINDOW_START=08:30
PUBLISH_WINDOW_END=11:30

# 텔레그램 알림 (선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
