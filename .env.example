# .env 양식 — 이 파일을 복사해서 이름을 .env 로 바꾸고 값을 채운다.
# .env 파일은 절대 다른 사람에게 보내거나 인터넷에 올리지 않는다.

# Anthropic API
ANTHROPIC_API_KEY=여기에_API_키
MODEL=claude-sonnet-5-5

# 네이버 (이사 블로그)
NAVER_ID=taegunam-
NAVER_PW=여기에_비밀번호
NAVER_CATEGORY=포장이사

# 회사 정보
COMPANY_PHONE=010-0000-0000

# 사진 폴더 (Google Drive 데스크톱 동기화 폴더 경로)
PHOTO_DIR=G:/내 드라이브/블로그사진

# 실행 설정
AUTO_PUBLISH=false
DAILY_LIMIT=2
PUBLISH_WINDOW_START=08:30
PUBLISH_WINDOW_END=11:30

# 텔레그램 알림 (선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
