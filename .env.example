# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 값을 채우세요.

# 내 블로그 아이디 (blog.naver.com/여기부분)
BLOG_ID=

# AI 설정: 둘 중 하나만 넣으면 됩니다. 둘 다 비워 두면 claude.ai나 ChatGPT 사이트에 직접 붙여 넣는 '수동 모드'로 동작해요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# 1로 바꾸면 확인 없이 바로 발행합니다 (익숙해질 때까지는 0 추천)
AUTO_PUBLISH=0
